# Copy to .env (chmod 600) and fill in yourself. Never paste keys into a chat (spec §0.3).
# .env, .env.test and .env.llm are gitignored; only this example is committed.

# Trading account, Alpaca paper (B6, D1). Keys need trading scope only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# paper | live. Live also needs the go-live checklist to validate (I5); v1 refuses it.
TRADING_MODE=paper

# Telegram alerts and /kill (B15). `quant control whoami` finds the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# .env.test holds the integration-test paper account (AD3), with the same two names:
#   ALPACA_API_KEY=
#   ALPACA_SECRET_KEY=
# /opt/quant-llm/.env.llm holds only ANTHROPIC_API_KEY (B17, AD4); it never lives in this repo.
